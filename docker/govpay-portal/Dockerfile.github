FROM eclipse-temurin:25-jre-alpine

ARG govpay_portal_fullversion
# sha256 del jar della release: la pipeline lo calcola dall'artifact della
# build, build_image.sh lo legge dalle API delle release di GitHub.
ARG govpay_portal_sha256
ARG govpay_portal_home=/opt/govpay-portal
ARG govpay_portal_log=/var/log/govpay-portal

LABEL maintainer="Link.it s.r.l."
LABEL description="GovPay Portal REST API"
LABEL govpay.portal.version="${govpay_portal_fullversion}"
USER root

ENV GOVPAY_PORTAL_FULLVERSION=${govpay_portal_fullversion} \
GOVPAY_PORTAL_LOGDIR=${govpay_portal_log} \
GOVPAY_PORTAL_HOME=${govpay_portal_home} \
TZ=Europe/Rome


RUN set -eux; \
apk update; \
apk upgrade; \
# Solo cio' che serve a runtime: bash per l'entrypoint, tzdata per il fuso
# orario. tar, unzip, netcat e curl non sono usati dall'entrypoint, e ogni
# pacchetto in piu' e' superficie esposta e segnalazioni della scansione.
apk add --no-cache bash tzdata; \
rm -rf /var/cache/apk/*; \
echo "${TZ}" > /etc/timezone; \
addgroup -S govpay ; \
adduser -S -G govpay govpay; \
mkdir -p ${GOVPAY_PORTAL_HOME} ${GOVPAY_PORTAL_LOGDIR} /opt/sql /opt/jdbc-drivers; \
chown -R govpay:govpay ${GOVPAY_PORTAL_HOME} ${GOVPAY_PORTAL_LOGDIR} /opt/sql

WORKDIR ${GOVPAY_PORTAL_HOME}

# Download del jar dalla release GitHub, con verifica del certificato e del
# checksum: senza checksum l'immagine conterrebbe qualunque file venisse
# servito a quell'indirizzo. curl serve solo qui: installato e rimosso nello
# stesso passo, non resta nell'immagine.
RUN set -eux; \
apk add --no-cache --virtual .download curl; \
test -n "${govpay_portal_sha256}" || { echo "Manca il build-arg govpay_portal_sha256 (sha256 del jar della release)"; exit 1; }; \
curl -fL -sS -o /opt/govpay-portal/govpay-portal-api.jar "https://github.com/link-it/govpay-portal-api/releases/download/${GOVPAY_PORTAL_FULLVERSION}/govpay-portal-api-${GOVPAY_PORTAL_FULLVERSION}.jar"; \
echo "${govpay_portal_sha256}  /opt/govpay-portal/govpay-portal-api.jar" | sha256sum -c -; \
apk del .download


# Copy entrypoint and initialization scripts
COPY commons/entrypoint.sh /usr/local/bin/
RUN chown -R govpay:0 /usr/local/bin/entrypoint.sh ${GOVPAY_PORTAL_HOME} ${GOVPAY_PORTAL_LOGDIR} \
&& chmod -Rf g+rwX ${GOVPAY_PORTAL_HOME} ${GOVPAY_PORTAL_LOGDIR} \
&& chmod ug=rx /usr/local/bin/entrypoint.sh



USER govpay

ENV PORTAL_TIME_ZONE=Europe/Rome \
    SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000 \
    SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=10000 \
    SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=600000 \
    LOGGING_FILE_NAME=${GOVPAY_PORTAL_LOGDIR}/govpay-portal-api.log \
    LOGGING_DIRECTORYPATH=${GOVPAY_PORTAL_LOGDIR} \
    LOGGING_FILEPREFIX=govpay-portal-api


ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
